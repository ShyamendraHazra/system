    "configurations": [
         {
      "name": "Launch with LLDB",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Linux/${workspaceFolderBasename}_linux_test",   // ⬅️ your compiled binary
